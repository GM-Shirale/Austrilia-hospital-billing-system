# Copy to .env (never commit .env). Used by docker compose.
DB_PASSWORD=postgres
# Base64 of at least 32 random bytes:  openssl rand -base64 48
JWT_SECRET=
# Spring AI (optional). AI_ENABLED=false keeps every AI feature on its rule-based fallback.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# e.g. BACKEND_PROFILES=kafka,redis together with --profile kafka --profile redis
BACKEND_PROFILES=
