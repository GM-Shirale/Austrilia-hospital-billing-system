<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aggregator so that opening the ROOT folder in IntelliJ imports the backend as a Maven
  module. The React frontend is a plain npm project in ./frontend.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.hospital</groupId>
    <artifactId>australia-hospital-billing</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>australia-hospital-billing</name>

    <modules>
        <module>backend</module>
    </modules>

    <!--
      Lets "mvn clean spring-boot:run" work from this root folder as well as from ./backend:
      the goal is skipped for this aggregator and runs the backend module.
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.5.14</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
